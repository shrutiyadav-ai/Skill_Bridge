  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

enum CollaborationStatus {
  OPEN
  APPLIED
  ACTIVE
  COMPLETED
  REJECTED
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
